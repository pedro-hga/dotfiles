exec_always --no-startup-id xrdb -merge ~/.Xresources

focus_follows_mouse no
mouse_warping none

set $mod Mod4
floating_modifier $mod

font pango:Lilex Nerd Font 14

new_window pixel 4
new_float pixel 0

gaps inner 12
gaps top 48
# gaps outer 2

# Colors
set $bg0      #191724
set $bg1      #1f1d2e
set $bg2      #26233a
set $bg3      #2a273f
set $bg4      #393552
set $bg5      #44415a

set $fg0      #e0def4
set $fg1      #d9d7ee
set $fg2      #908caa
set $fg3      #6e6a86

set $yellow   #ea9d34
set $orange   #ea9a97
set $red      #eb6f92
set $magenta  #ebbcba
set $violet   #c4a7e7
set $blue     #9ccfd8
set $cyan     #9ccfd8
set $green    #31748f
set $gray     #6e6a86

include ~/.config/i3/conf.d/*.conf
