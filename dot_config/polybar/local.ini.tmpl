{{- if eq .chezmoi.hostname "desk" }}

[bar/main]
height = 52
offset-y = 18
font-0 = Iosevka Nerd Font:size=21;5
module-margin-right = 1
modules-right = keyboard separator volume separator lightness separator dunst separator tray

[module/tray]
tray-spacing = 32

{{- else if eq .chezmoi.hostname "s145" }}

[bar/main]
height = 36
offset-y = 12
font-0 = Iosevka Nerd Font:size=14;5
modules-right = keyboard separator volume separator lightness separator battery separator dunst separator tray

[module/battery]
type = custom/script
exec = ~/.config/i3/scripts/battery.sh
interval = 15
format-padding = 1

[module/tray]
tray-spacing = 16

{{- end }}
